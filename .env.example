# 이 파일은 이름만 적는다. 실제 값은 .env.local(로컬)과 Vercel 환경변수(배포)에만 둔다.
# .env.local은 저장소에 올리지 않는다(.gitignore).

# Supabase (공개 가능, 행 단위 권한을 따른다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret 키 (서버 전용, 행 단위 권한을 우회한다. 브라우저 코드에서 쓰지 않는다)
SUPABASE_SECRET_KEY=

# 공공데이터포털 인증키(계정당 하나. 마이홈·기상청·실거래가 공통, API마다 활용신청은 따로. 온통청년은 아래 별도 키)
DATA_GO_KR_SERVICE_KEY=

# 온통청년 청년정책 API 인증키 (서버 전용. 청년 주거 정책 수집, spec 006. 코드는 이 이름을 읽는다)
YOUTH_POLICY_API_KEY=
# 한국전력 전력데이터개방포털(bigdata.kepco.co.kr) 가구평균 전력사용량, spec 011
KEPCO_API_KEY=

# LLM 공급자 (spec 002). gemini | claude | mock
# 비우면 개발·시험은 mock(실제 API를 부르지 않음), 운영 배포는 "AI 설정 없음"으로 기본 체크리스트만 만든다
AI_PROVIDER=

# Gemini API (개발용 무료 플랜, Google AI Studio에서 받음). 모델은 비우면 plan 002의 기본값
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude API (배포용, 요약·대응안 초안에만)
ANTHROPIC_API_KEY=

# 슬랙 알림 봇 토큰 (spec 001 FR-018, 팀 슬랙 앱. xoxb-로 시작)
SLACK_BOT_TOKEN=

# 알림 링크의 앞부분(선택). 비우면 Vercel 운영 주소, 로컬은 http://localhost:3000
APP_BASE_URL=

# 웹 푸시 알림 (spec 021). 셋 다 있어야 켜진다. 키 한 쌍은 `npx web-push generate-vapid-keys`로 만든다
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 서버 전용 비밀 키
VAPID_PRIVATE_KEY=
# 연락처, mailto:로 시작
VAPID_SUBJECT=

# Vercel 정기 실행 보호용 비밀 값 (16자 이상)
CRON_SECRET=

# 시뮬레이션을 돌릴 가상(시험) 계정 회원 ID, 쉼표로 여럿. 실제 계정은 넣지 않는다
SIMULATION_USER_IDS=
