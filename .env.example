# 이 파일은 이름만 적는다. 실제 값은 .env.local(로컬)과 Vercel 환경변수(배포)에만 둔다.
# .env.local은 저장소에 올리지 않는다(.gitignore).

# Supabase (공개 가능, 행 단위 권한을 따른다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret 키 (서버 전용, 행 단위 권한을 우회한다. 브라우저 코드에서 쓰지 않는다)
SUPABASE_SECRET_KEY=

# 공공데이터포털 마이홈 공공임대 공고 API 인증키
MYHOME_SERVICE_KEY=

# Claude API (요약·대응안 초안에만)
ANTHROPIC_API_KEY=

# Vercel 정기 실행 보호용 비밀 값 (16자 이상)
CRON_SECRET=
