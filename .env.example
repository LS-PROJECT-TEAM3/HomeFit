# 이 파일은 이름만 적는다. 실제 값은 .env.local(로컬)과 Vercel 환경변수(배포)에만 둔다.
# .env.local은 저장소에 올리지 않는다(.gitignore).

# Supabase (공개 가능, 행 단위 권한을 따른다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret 키 (서버 전용, 행 단위 권한을 우회한다. 브라우저 코드에서 쓰지 않는다)
SUPABASE_SECRET_KEY=

# 공공데이터포털 인증키(계정당 하나. 마이홈·온통청년·기상청·실거래가 공통, API마다 활용신청은 따로)
DATA_GO_KR_SERVICE_KEY=

# LLM 공급자 (spec 002). gemini | claude | mock
# 비우면 개발·시험은 mock(실제 API를 부르지 않음), 운영 배포는 "AI 설정 없음"으로 기본 체크리스트만 만든다
AI_PROVIDER=

# Gemini API (개발용 무료 플랜, Google AI Studio에서 받음). 모델은 비우면 plan 002의 기본값
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude API (배포용, 요약·대응안 초안에만)
ANTHROPIC_API_KEY=

# 슬랙 알림 봇 토큰 (spec 001 FR-018, 팀 슬랙 앱. xoxb-로 시작)
SLACK_BOT_TOKEN=

# 알림 링크의 앞부분(선택). 비우면 Vercel 운영 주소, 로컬은 http://localhost:3000
APP_BASE_URL=

# Vercel 정기 실행 보호용 비밀 값 (16자 이상)
CRON_SECRET=
